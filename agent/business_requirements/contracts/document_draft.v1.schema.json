{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ragflow:business-requirements:document-draft:v1",
  "title": "Business requirements document AST",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "template_version", "sections"],
  "properties": {
    "schema_version": {"const": "1"},
    "document_type": {"const": "business_requirements"},
    "template_version": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": ["id", "title", "blocks"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 16},
            "title": {"type": "string", "minLength": 1, "maxLength": 500},
            "evidence_refs": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^ragflow://dataset/[^\\s]+/document/[^\\s]+/chunk/[^\\s]+$"}
            },
            "blocks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "text"],
                  "properties": {
                    "type": {"const": "paragraph"},
                    "text": {"type": "string", "minLength": 1, "maxLength": 20000}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "items"],
                  "properties": {
                    "type": {"const": "list"},
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "items": {"type": "string", "minLength": 1, "maxLength": 5000}
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "headers", "rows"],
                  "properties": {
                    "type": {"const": "table"},
                    "headers": {
                      "type": "array",
                      "minItems": 1,
                      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {"type": ["string", "number", "boolean", "null"]}
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "source"],
                  "properties": {
                    "type": {"const": "plantuml"},
                    "source": {"type": "string", "minLength": 1, "maxLength": 50000}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "source"],
                  "properties": {
                    "type": {"const": "bpmn"},
                    "source": {"type": "string", "minLength": 1, "maxLength": 100000}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "alt", "url"],
                  "properties": {
                    "type": {"const": "image"},
                    "alt": {"type": "string", "minLength": 1, "maxLength": 1000},
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 5000,
                      "pattern": "^https?://[^\\s]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "label", "url"],
                  "properties": {
                    "type": {"const": "reference"},
                    "label": {"type": "string", "minLength": 1, "maxLength": 1000},
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 5000,
                      "pattern": "^https?://[^\\s]+$"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
