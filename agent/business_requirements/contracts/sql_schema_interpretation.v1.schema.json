{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragflow.local/contracts/sql_schema_interpretation.v1.schema.json",
  "title": "SQL schema interpretation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolutions"],
  "properties": {
    "schema_version": { "const": "1" },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "kind",
          "normalized_term",
          "recommended_entity_id",
          "recommended_column_ids",
          "confidence",
          "reason",
          "clarification_question"
        ],
        "properties": {
          "term": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": { "enum": ["entity", "field", "unknown"] },
          "normalized_term": { "type": "string", "minLength": 1, "maxLength": 200 },
          "recommended_entity_id": { "type": ["string", "null"], "maxLength": 500 },
          "recommended_column_ids": {
            "type": "array",
            "maxItems": 60,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "clarification_question": { "type": ["string", "null"], "maxLength": 1000 }
        }
      }
    }
  }
}
