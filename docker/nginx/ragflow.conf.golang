server {
    listen 80;
    server_name _;
    root /ragflow/web/dist;

    gzip on;
    gzip_min_length 1k;
    gzip_comp_level 9;
    gzip_types text/plain application/javascript application/x-javascript text/css application/xml text/javascript application/x-httpd-php image/jpeg image/gif image/png;
    gzip_vary on;
    gzip_disable "MSIE [1-6]\.";

    location = /asr {
        absolute_redirect off;
        return 308 /asr/;
    }
    location ^~ /asr/ {
        resolver 127.0.0.11 valid=30s;
        set $asr_upstream t-one-asr:9011;
        rewrite ^/asr/(.*)$ /$1 break;
        proxy_pass http://$asr_upstream;
        include proxy.conf;
    }

    location = /translate {
        absolute_redirect off;
        return 308 /translate/;
    }
    location = /translate/address-form {
        absolute_redirect off;
        return 308 /translate/address-form/;
    }
    location ^~ /translate/address-form/ {
        proxy_pass http://host.docker.internal:8094;
        include proxy.conf;
    }
    location ^~ /address-api/ {
        proxy_pass http://host.docker.internal:8094;
        include proxy.conf;
    }
    location ^~ /translate/ {
        proxy_pass http://host.docker.internal:8092;
        include proxy.conf;
    }

    location ~ ^/api/v1/admin/document-quality {
        proxy_pass http://127.0.0.1:9381;
        include proxy.conf;
    }

    location ~ ^/api/v1/admin {
        proxy_pass http://127.0.0.1:9383;
        include proxy.conf;
    }

    location ~ ^/api/v1/skills {
        proxy_pass http://127.0.0.1:9384;
        include proxy.conf;
    }

    location ~ ^/(v1|api) {
        proxy_pass http://127.0.0.1:9384;
        include proxy.conf;
    }

    location ^~ /plantuml/ {
        proxy_pass http://plantuml-server:8080/;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
        client_max_body_size 1m;
    }

    location / {
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Cache-Control: max-age Expires
    location ~ ^/static/(css|js|media)/ {
        expires 10y;
        access_log off;
    }
}
